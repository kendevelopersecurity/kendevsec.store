rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /uploads/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource != null
        && ((request.resource.size <= 5 * 1024 * 1024
          && request.resource.contentType in ['image/jpeg','image/png','image/webp','image/gif'])
          || (request.resource.size <= 15 * 1024 * 1024
          && request.resource.contentType in ['audio/mpeg','audio/mp3','audio/ogg','audio/wav','audio/x-wav','audio/mp4']));
      allow delete: if isAdmin();
    }
  }
}
